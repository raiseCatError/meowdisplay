<?xml version="1.0" encoding="utf-8"?>
<!-- Pins and the install id are this device's trust state: never backed up or
     transferred, so a restored or cloned device pairs afresh. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
