# The published release that installed Mac copies run today. Release checks
# compare against THIS, not against project.yml: the Sparkle key installed
# copies trust, the designated requirement TCC and the Keychain evaluate, the
# entitlements, and the live feed URLs. Change it only deliberately, in its own
# reviewed commit, after a newer release has been verified live.
REPO=raiseCatError/meowdisplay
TEAM_ID=CZ8BW9J896
BASELINE_TAG=v2.0.0
BASELINE_URL=https://github.com/raiseCatError/meowdisplay/releases/download/v2.0.0
BASELINE_SUPUBLICEDKEY=M9Je3RXE9GYGv7ZvVmJj2xK2FrpSR/rQvbuZFfYORcU=
LIVE_FEED_BASE=https://meowdisplay.app

SENDER_DMG=MeowDisplay.dmg
SENDER_DMG_SHA256=9b9fb406774d40ca737d74fb597d9dd8eaf7b3877d6bc4e6d294fff7d239bae7
SENDER_APP="MeowDisplay.app"
SENDER_BUNDLE_ID=com.raisecaterror.meowdisplay.mac
SENDER_FEED=appcast.xml

RECEIVER_DMG=MeowDisplayReceiver.dmg
RECEIVER_DMG_SHA256=3860b8941aa48e8f48b59f7252be8fe742c6bbd01c22b067a5861cb847581d98
RECEIVER_APP="MeowDisplay Receiver.app"
RECEIVER_BUNDLE_ID=com.raisecaterror.meowdisplay.mac.receiver
RECEIVER_FEED=appcast-receiver.xml

# Loads the per-app values for "sender" or "receiver" into DMG, DMG_SHA256,
# APP, BUNDLE_ID and FEED.
select_app() {
  case "$1" in
    sender) DMG=$SENDER_DMG DMG_SHA256=$SENDER_DMG_SHA256 APP=$SENDER_APP BUNDLE_ID=$SENDER_BUNDLE_ID FEED=$SENDER_FEED ;;
    receiver) DMG=$RECEIVER_DMG DMG_SHA256=$RECEIVER_DMG_SHA256 APP=$RECEIVER_APP BUNDLE_ID=$RECEIVER_BUNDLE_ID FEED=$RECEIVER_FEED ;;
    *) echo "::error::unknown app '$1' (sender or receiver)"; return 1 ;;
  esac
}
