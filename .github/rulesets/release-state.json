{
  "name": "Release state: only the release workflows update it",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/release-state"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 15368,
      "actor_type": "Integration",
      "bypass_mode": "always"
    }
  ],
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "update"
    },
    {
      "type": "creation"
    }
  ]
}
