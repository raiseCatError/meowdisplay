IOS_BUNDLE_ID = "com.raisecaterror.meowdisplay.ios"

def asc_api_key
  app_store_connect_api_key(
    key_id:                ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
    issuer_id:             ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
    key_content:           ENV.fetch("APP_STORE_CONNECT_KEY_CONTENT"),
    is_key_content_base64: true
  )
end

# CI passes the release version + a monotonic build number through the
# environment; turn them into xcodebuild overrides. Empty when unset, so
# local builds fall back to the defaults in project.yml.
def version_xcargs
  args = []
  version = ENV["APP_MARKETING_VERSION"].to_s
  build   = ENV["APP_BUILD_NUMBER"].to_s
  args << "MARKETING_VERSION=#{version}" unless version.empty?
  args << "CURRENT_PROJECT_VERSION=#{build}" unless build.empty?
  args.join(" ")
end

platform :mac do
  desc "Build Developer ID-signed, notarized macOS app for direct distribution"
  lane :build_release do
    build_notarized_mac_app(
      scheme:    "OpenSidecarMac",
      bundle_id: "com.raisecaterror.meowdisplay.mac",
      name:      "MeowDisplay"
    )
  end

  # The standalone receiver app (issue #241): same pipeline, own bundle id and
  # DMG. Its Developer ID profile must exist in the match repo (run
  # `fastlane match developer_id` once locally after adding the bundle id).
  desc "Build the Developer ID-signed, notarized MeowDisplay Receiver app"
  lane :build_receiver_release do
    build_notarized_mac_app(
      scheme:    "OpenSidecarMacReceiver",
      bundle_id: "com.raisecaterror.meowdisplay.mac.receiver",
      name:      "MeowDisplay Receiver"
    )
  end

  # Shared body of the two Mac lanes. `name` is the PRODUCT_NAME (the .app
  # basename); the DMG is named without spaces so release-asset URLs stay
  # clean (`MeowDisplay.dmg`, `MeowDisplayReceiver.dmg`).
  private_lane :build_notarized_mac_app do |options|
    scheme    = options[:scheme]
    bundle_id = options[:bundle_id]
    name      = options[:name]
    app       = "build/export/#{name}.app"
    dmg       = "build/export/#{name.delete(' ')}.dmg"

    setup_ci if is_ci
    key = asc_api_key
    # Developer ID certs can't be managed via ASC API key — Apple limitation.
    # CI uses readonly: true so it just reads from the git repo, no Apple auth needed.
    match(
      type:           "developer_id",
      app_identifier: bundle_id,
      readonly:       is_ci
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "MeowDisplay.xcodeproj",
      code_sign_identity:    "Developer ID Application",
      profile_name:          "match Direct #{bundle_id} macos",
      targets:               [scheme]
    )
    build_mac_app(
      project:          "MeowDisplay.xcodeproj",
      scheme:           scheme,
      configuration:    "Release",
      export_method:    "developer-id",
      output_directory: "build/export",
      output_name:      name,
      xcargs:           version_xcargs
    )
    # gym/notarize resolve relative paths against the repo root, but during a
    # lane fastlane chdir's the process into fastlane/, so a shell `sh` block
    # (and File.expand_path) would resolve "build/..." under fastlane/ instead.
    # Keep the fastlane actions on repo-root-relative paths, and cd the shell
    # block to the repo root so every path agrees.
    notarize(
      package:   app,
      bundle_id: bundle_id,
      api_key:   key
    )

    # Wrap the notarized app in a DMG for a friendlier download. Use hdiutil
    # (built-in) rather than create-dmg to avoid the AppleScript window-styling
    # step that is flaky in headless CI. Sign the DMG with the Developer ID
    # identity match installed, then notarize + staple it too — so the
    # downloaded disk image itself passes Gatekeeper without a prompt.
    sh(<<~BASH)
      set -euo pipefail
      cd "$(git rev-parse --show-toplevel)"
      rm -rf build/dmg-src
      mkdir -p build/dmg-src
      cp -R "#{app}" build/dmg-src/
      ln -s /Applications build/dmg-src/Applications
      hdiutil create -volname "#{name}" -srcfolder build/dmg-src -ov -format UDZO "#{dmg}"
      codesign --force --sign "Developer ID Application" --timestamp "#{dmg}"
    BASH
    notarize(
      package:   dmg,
      bundle_id: bundle_id,
      api_key:   key
    )
  end
end

platform :ios do
  # Optional TestFlight path for beta testing. Not part of the normal App Store
  # release flow; run it when a build should go to testers first.
  desc "Build and upload to TestFlight"
  lane :beta do
    ipa = build_app_store_ipa
    upload_to_testflight(
      api_key:                           lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      app_identifier:                    IOS_BUNDLE_ID,
      ipa:                               ipa,
      skip_waiting_for_build_processing: true
    )
  end

  # App Store release candidate: uploads the binary only. Metadata and
  # screenshots are managed by hand in App Store Connect, and submission for
  # review and the release itself stay manual. With skip_metadata, deliver
  # never sets the version's release type, so choose "Manually release this
  # version" in App Store Connect before submitting. Precheck only matters when
  # submitting, so it is off here.
  desc "Build and upload an App Store release candidate (no review submission)"
  lane :release do
    ipa = build_app_store_ipa
    upload_to_app_store(
      api_key:                    lane_context[SharedValues::APP_STORE_CONNECT_API_KEY],
      app_identifier:             IOS_BUNDLE_ID,
      ipa:                        ipa,
      skip_metadata:              true,
      skip_screenshots:           true,
      submit_for_review:          false,
      run_precheck_before_submit: false
    )
  end

  # Shared by both lanes: App Store-signed Release build of the iOS app.
  private_lane :build_app_store_ipa do
    setup_ci if is_ci
    key = asc_api_key
    match(
      type:           "appstore",
      app_identifier: IOS_BUNDLE_ID,
      api_key:        key,
      readonly:       is_ci
    )
    update_code_signing_settings(
      use_automatic_signing: false,
      path:                  "MeowDisplay.xcodeproj",
      code_sign_identity:    "Apple Distribution",
      profile_name:          "match AppStore #{IOS_BUNDLE_ID}",
      targets:               ["OpenSidecariOS"]
    )
    build_app(
      project:          "MeowDisplay.xcodeproj",
      scheme:           "OpenSidecariOS",
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: "build/export",
      output_name:      "OpenSidecariOS",
      xcargs:           version_xcargs
    )
  end
end
